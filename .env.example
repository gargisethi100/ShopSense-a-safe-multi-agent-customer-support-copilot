# ShopSense — environment template
#
# HOW TO USE
#   copy .env.example .env      (PowerShell: Copy-Item .env.example .env)
#   then fill in the blanks in .env
#
# .env.example IS committed. It documents the shape of the config so a new
# machine (or Render, or CI) knows what it needs. It must never contain a real
# value.
#
# .env is NEVER committed and never enters the Docker image. On Render these
# same keys are injected as runtime environment variables instead.
#
# ---------------------------------------------------------------------------
# There are two kinds of variable in this file, and the difference matters.
#
#   SECTION A — names chosen by libraries we depend on. We do NOT get to
#               rename these. A typo here fails silently: the library just
#               behaves as if the value were absent.
#
#   SECTION B — names we chose. All carry the SHOPSENSE_ prefix so that
#               anything without it is visibly somebody else's contract.
#               config.py is the only file allowed to read these.
# ---------------------------------------------------------------------------


# ===========================================================================
# SECTION A — read directly by third-party libraries. Names are fixed.
# ===========================================================================

# --- AWS Bedrock credentials (Phase 3.5) -------------------------------------
# Read by boto3, the AWS SDK underneath langchain-aws. Claude is reached
# through Amazon Bedrock in this project. Authenticate ONE of two ways:
#
# Option 1 - a Bedrock API key (bearer token). Simplest; needs boto3 >= 1.39.
AWS_BEARER_TOKEN_BEDROCK=
#
# Option 2 - a classic IAM access-key pair (leave Option 1 empty if used):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
#
# The AWS region your Bedrock access lives in. Model availability differs by
# region - the ids listed by `python llm.py list` are per-region.
AWS_REGION=us-east-1
#
# SET A BUDGET ALARM in AWS (Billing -> Budgets) before going public. A demo
# URL will be probed, and an uncapped key is an uncapped bill.

# --- LangSmith tracing (Phase 8) ---------------------------------------------
# The langsmith client resolves each of these by trying the LANGSMITH_ prefix
# first and falling back to the older LANGCHAIN_ one. Use LANGSMITH_.
# Leave LANGSMITH_TRACING unset or "false" until Phase 8 — every traced run is
# an extra network call you don't need while learning Phase 0.

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=shopsense-dev
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com   # only for self-hosted


# ===========================================================================
# SECTION B — read by our config.py. Names are ours.
# ===========================================================================

# --- Database (Phase 1) ------------------------------------------------------
# Three connection strings, ONE database. They differ only in the Postgres role
# they authenticate as, and that is the entire point: the privilege boundary
# lives in the database, not in a prompt.
#
# Neon gives you the ADMIN one when you create the project. We create the other
# two roles ourselves in db/roles.sql, so those URLs won't exist until Phase 1.
#
# Format:
#   postgresql://USER:PASSWORD@ep-xxxx-yyyy.REGION.aws.neon.tech/neondb?sslmode=require
# Keep ?sslmode=require — Neon refuses plaintext connections.

# Owner. Runs migrations and seed.py. NEVER used by the agent at runtime.
SHOPSENSE_DB_URL_ADMIN=

# The agent's connection. SELECT on exactly three tables; no INSERT, UPDATE,
# DELETE, or DDL. A prompt-injected "DROP TABLE orders" is not discouraged
# here, it is impossible.
SHOPSENSE_DB_URL_RO=

# The single write path, used only by the refund tool, and only after a human
# has approved the interrupt. Scoped to the refunds table alone.
SHOPSENSE_DB_URL_WRITER=

# --- Models (Phase 0 / rewired for Bedrock in Phase 3.5) ---------------------
# On Bedrock, Claude ids carry an `anthropic.` prefix - and most accounts must
# use the cross-region "inference profile" form, which prepends a geography:
# us. / eu. / apac. / global. (config.py strips that prefix for pricing, so
# either form works here.)
#
# TWO SEPARATE FACTS, both discovered not guessed:
#   1. WHAT THE REGION OFFERS ->  python llm.py list
#   2. WHAT YOUR ACCOUNT MAY CALL -> only a real call proves it; a listed
#      model can still answer AccessDeniedException. Enable models in the
#      AWS console: Bedrock -> Model access.
#
# Prices are set by AWS, not Anthropic - verify config.py's MODEL_PRICING
# against https://aws.amazon.com/bedrock/pricing/ before trusting the footer.
#
# Capabilities differ per model and config.py enforces them so no node can
# get it wrong: the Claude 5 generation rejects `temperature`; claude-haiku-4-5
# rejects the `output_config.effort` field.

# The specialist agents — order_agent and policy_agent — do the real reasoning.
SHOPSENSE_MODEL_AGENT=us.anthropic.claude-sonnet-4-6

# The classifiers: supervisor routing, scope check, injection screen. These are
# high-volume "pick one label" calls, so Haiku (~3x cheaper) fits - and it
# accepts temperature=0, which makes routing deterministic and the Phase 10
# routing evals stable.
SHOPSENSE_MODEL_ROUTER=us.anthropic.claude-haiku-4-5-20251001-v1:0

# On claude-opus-5, thinking is ON by default and max_tokens caps thinking AND
# the visible answer TOGETHER. Set too low, answers truncate mid-sentence.
SHOPSENSE_MAX_TOKENS=4096

# How hard the model works: low | medium | high | xhigh | max. Default is high.
# "medium" is a sensible balance for customer support; raise it if answers feel
# shallow, rather than adding "think carefully" to the prompt.
SHOPSENSE_EFFORT=medium

# --- Guardrails (Phase 7) ----------------------------------------------------
# monitor = log what WOULD have been blocked, but let it through
# enforce = actually block
#
# Always start in monitor. A guardrail tuned against imagined attacks blocks
# real customers; one tuned against your own real traffic doesn't.
SHOPSENSE_GUARDRAILS_MODE=monitor

# --- App ---------------------------------------------------------------------
SHOPSENSE_LOG_LEVEL=INFO
